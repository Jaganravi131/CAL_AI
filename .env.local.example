# Supabase (public) - client-side
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbpbl_XXXXXXXXXXXXXXXXXXXX

# This must be the public/publishable key, not the secret/service-role key.

# Supabase Functions (set these in the Supabase dashboard or with `supabase secrets set`)
# OPENAI_API_KEY should be configured as a secret for your functions, NOT checked into source.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-4o-mini

# Groq API (client-side)
EXPO_PUBLIC_GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXX
